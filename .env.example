# ─────────────────────────────────────────────────────────────
# Syslog AI Monitor — configuration
# Copy this file to ".env" and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Anthropic API (required) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Evaluation schedule & retention
EVAL_INTERVAL_MINUTES=60      # how often to evaluate. 60 = top of every hour
                             # (9:00, 10:00). Divisors of 60 (30, 15, ...) align
                             # to the hour too; other values run from start.
RETENTION_DAYS=30            # how long to keep AI findings (history)

# Weekly pattern review — rolls up recent hourly findings to surface recurring
# issues and trends. Runs once a day over a rolling window.
WEEKLY_WINDOW_DAYS=7         # how many days of findings to review
WEEKLY_REVIEW_HOUR=6         # local hour-of-day (0-23) to run the review

# Timezone for scheduling + log timestamps (IANA name). Set this so evaluations
# land on YOUR local top-of-hour, not UTC. e.g. America/Chicago, America/New_York
TZ=America/Chicago

# Network ports
#
# Two different things, easy to confuse:
#   WEB_HOST_PORT  the port on the Pi you browse to      (compose, left side)
#   WEB_PORT       the port the app binds in the container (app, right side)
# They are NOT interchangeable. Changing WEB_PORT alone moves the app inside the
# container while the compose mapping still targets 8080, and the dashboard goes
# dark with nothing in the logs to explain it. Normally you only touch the first.
#
# 80 needs no extra privilege: the host side of a Docker port publish is bound by
# dockerd, which already runs as root.
SYSLOG_PORT=514               # UDM Pro sends syslog here (UDP + TCP)
WEB_HOST_PORT=80              # dashboard: http://<pi-ip>
WEB_PORT=8080                 # in-container listen port; leave this alone

# Digest limits (controls token/cost per evaluation)
DIGEST_MAX_TEMPLATES=60       # top-N distinct message patterns to send
DIGEST_MAX_SAMPLES=200        # max elevated-severity sample lines to send
DIGEST_MAX_CHARS=24000        # hard cap on digest size sent to the model

# Raw-buffer safety bounds. Raw logs are deliberately KEPT when a Claude call
# fails so the window isn't lost — these keep that from growing without limit
# during a sustained outage (which once reached 15.9M rows / 5 GB and made each
# hourly run take 41 minutes, browning out the dashboard).
EVAL_MAX_ROWS=500000          # max raw rows one evaluation pulls at a time
RAW_LOG_MAX_AGE_HOURS=24      # drop unevaluated raw logs older than this; 0 = no bound
ALERT_FAILURE_COOLDOWN_HOURS=6  # min gap between "evaluation FAILED" emails

# Circuit breaker. A permanent model error (billing, auth) can't clear on retry,
# so after one the scheduled evaluation is skipped entirely — no fetch, no
# digest — until the backoff expires. Doubles from the base up to the cap; any
# success resets it. POST /api/run-now always bypasses it.
BREAKER_BACKOFF_BASE_MINUTES=60  # first backoff after a permanent failure
BREAKER_BACKOFF_MAX_HOURS=6      # ceiling (1h -> 2h -> 4h -> 6h -> 6h ...)

# ─────────────────────────────────────────────────────────────
# MQTT / Home Assistant (optional) — leave MQTT_HOST blank to disable.
#
# Publishes state plus an availability topic with a Last Will, so the broker
# announces "offline" on this box's behalf when it drops. That is the fleet's
# dead-device detection: syslog is push-only, so a healthy quiet host and a dead
# host are indistinguishable. Ping can't substitute — ICMP is answered by the
# kernel, so a host with wholly wedged userspace still replies.
# ─────────────────────────────────────────────────────────────
MQTT_HOST=                    # e.g. 192.168.0.105 (Mosquitto add-on on Home Assistant)
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_BASE_TOPIC=syslog_monitor     # state under <base>/..., availability at <base>/status
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_PUBLISH_INTERVAL_MINUTES=1    # heartbeat; keeps HA fresh between hourly evaluations

# ─────────────────────────────────────────────────────────────
# Email alerts (optional) — leave SMTP_HOST blank to disable email
# Gmail: use an App Password (https://myaccount.google.com/apppasswords),
#        SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=syslog-pi@example.com
ALERT_TO=jeff@strout.us
ALERT_MIN_SEVERITY=error      # email when a finding is this severity or higher:
                              # info < warning < error < critical
